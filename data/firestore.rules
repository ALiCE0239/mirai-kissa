rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isFirebaseAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/config/admins)
        && request.auth.uid in get(/databases/$(database)/documents/config/admins).data.uids;
    }

    function isOwnRankingEntry(entryId) {
      return request.auth != null
        && (entryId == request.auth.uid + '_challenge_live'
          || entryId == request.auth.uid + '_character_rank');
    }

    match /config/admins {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /userRewards/{userId} {
      allow read: if request.auth != null
        && (request.auth.uid == userId || isFirebaseAdmin());
      allow create, update: if isFirebaseAdmin()
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if isFirebaseAdmin();
    }

    match /rankingEntries/{entryId} {
      allow get: if isFirebaseAdmin()
        || (resource != null && resource.data.moderationStatus == 'approved')
        || isOwnRankingEntry(entryId);
      allow list: if isFirebaseAdmin()
        || (resource.data.moderationStatus == 'approved');
      allow create, update: if request.auth != null
        && request.resource.data.authorUid == request.auth.uid
        && entryId == request.auth.uid + '_' + request.resource.data.type
        && request.resource.data.type in ['challenge_live', 'character_rank']
        && request.resource.data.moderationStatus == 'pending';
      allow update: if isFirebaseAdmin();
      allow delete: if isFirebaseAdmin();
    }

    match /rankingModerationQueue/{entryId} {
      allow read, delete: if isFirebaseAdmin();
      allow create, update: if request.auth != null
        && request.resource.data.authorUid == request.auth.uid
        && entryId == request.auth.uid + '_' + request.resource.data.type
        && request.resource.data.type in ['challenge_live', 'character_rank']
        && request.resource.data.moderationStatus == 'pending';
    }

    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /publicProfiles/{publicId} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
    }
    match /linkHubs/{publicId} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
    }
    match /posts/{postId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.authorUid == request.auth.uid;
      allow update, delete: if request.auth != null
        && resource.data.authorUid == request.auth.uid;
    }
    match /posts/{postId}/likes/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    match /boardEventAds/{authorUid} {
      allow read: if request.auth != null && request.auth.uid == authorUid
        || (
          resource.data.get('isPublished', true) != false
          && (
            resource.data.get('visibility', 'public') == 'public'
            || (
              request.auth != null
              && resource.data.get('visibility', 'public') == 'friends'
              && exists(/databases/$(database)/documents/users/$(request.auth.uid)/friends/$(authorUid))
            )
          )
        );
      allow create, update: if request.auth != null
        && request.auth.uid == authorUid
        && request.resource.data.authorUid == authorUid;
      allow delete: if request.auth != null && request.auth.uid == authorUid;
    }
    match /boardMysekai/{authorUid} {
      allow read: if request.auth != null && request.auth.uid == authorUid
        || (
          resource.data.get('isPublished', true) != false
          && (
            resource.data.get('visibility', 'public') == 'public'
            || (
              request.auth != null
              && resource.data.get('visibility', 'public') == 'friends'
              && exists(/databases/$(database)/documents/users/$(request.auth.uid)/friends/$(authorUid))
            )
          )
        );
      allow create, update: if request.auth != null
        && request.auth.uid == authorUid
        && request.resource.data.authorUid == authorUid;
      allow delete: if request.auth != null && request.auth.uid == authorUid;
      match /updates/{updateId} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == authorUid;
      }
      match /likes/{likerUid} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == likerUid;
      }
    }
    match /users/{userId}/friends/{friendUid} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
        && (request.auth.uid == userId || request.auth.uid == friendUid);
      allow delete: if request.auth != null
        && (request.auth.uid == userId || request.auth.uid == friendUid);
    }
    match /users/{userId}/friendRequests/{requestId} {
      allow read: if request.auth != null
        && (request.auth.uid == userId || request.auth.uid == requestId);
      allow create: if request.auth != null
        && request.auth.uid == requestId
        && requestId != userId
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null
        && (request.auth.uid == userId || request.auth.uid == requestId);
    }
  }
}
