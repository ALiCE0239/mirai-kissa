rules_version = '2';
// Firebase Console → Storage → ルール に貼り付けて「公開」
// 掲示板画像: board/**  ユーザー画像: users/{uid}/**

service firebase.storage {
  match /b/{bucket}/o {
    match /board/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /users/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    // イベラン支援の終了スクショ（ネストパス用。公開ルールが1階層のみのときも上のワイルドカードでカバー）
    match /users/{userId}/eventArchives/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
