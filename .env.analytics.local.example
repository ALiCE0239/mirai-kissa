# コピー: cp .env.analytics.local.example .env.analytics.local
# Supabase → Account → Access Tokens で発行
SUPABASE_ACCESS_TOKEN=sbp_xxxxxxxx

# 管理者ページ #/admin のログイン（8文字以上推奨）
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=your-secure-password

# 任意（既存プロジェクトを使う場合）
# SUPABASE_PROJECT_REF=
# SUPABASE_URL=

# 任意
# PROJECT_NAME=mirai-kissa-analytics
# REGION=apac
